#!/usr/bin/env bash
#
# akari-tui — terminal frontend for the Akari Tool backend.
#
# Speaks exactly the same protocol as the QML GUI: it runs
# backend/akari-setup.sh and parses its machine-readable lines.
# No backend logic lives here. No dependencies beyond bash + coreutils,
# so it also runs on a bare Arch ISO.
#
# Usage: akari-tui [--help] [--version]
#
set -uo pipefail   # deliberately no -e: the UI loop handles failures itself

AKARI_TUI_VERSION="0.2.0"

# ---------------------------------------------------------------- backend

find_backend() {
  local here c
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for c in \
    "$here/../backend/akari-setup.sh" \
    "$here/backend/akari-setup.sh" \
    "/usr/share/akari-tool/backend/akari-setup.sh" \
    "/usr/lib/akari-tool/backend/akari-setup.sh"
  do
    [[ -r $c ]] && {
      printf '%s/%s\n' "$(cd "$(dirname "$c")" && pwd -P)" "$(basename "$c")"
      return 0
    }
  done
  command -v akari-setup.sh 2>/dev/null && return 0
  return 1
}

BACKEND="$(find_backend)" || {
  echo "akari-tui: cannot find backend/akari-setup.sh" >&2
  exit 1
}

# Run a backend command, capture stdout into the global array RESULT.
# Backend failures are non-fatal — the screen just shows what it got.
RESULT=()
backend() {
  RESULT=()
  local line
  while IFS= read -r line; do RESULT+=("$line"); done < <(bash "$BACKEND" "$@" 2>/dev/null)
  return 0
}

# ---------------------------------------------------------------- shared UI
# Drawing, input and generic screens live in lib/ui.sh, shared with
# tui/akari-install. Nothing Akari-specific belongs in there.
UI_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/ui.sh"
[[ -r $UI_LIB ]] || { echo "akari-tui: missing $UI_LIB" >&2; exit 1; }
# shellcheck source=/dev/null
source "$UI_LIB"

# do_action <title> <plan args...> -- <apply args...>
do_action() {
  local title=$1; shift
  local -a plan_args=() apply_args=(); local seen=0 a
  for a in "$@"; do
    if [[ $a == "--" && $seen == 0 ]]; then seen=1; continue; fi
    if (( seen )); then apply_args+=("$a"); else plan_args+=("$a"); fi
  done

  term_done
  term_size
  clear
  printf '%s%s%s\n' "$C_RED$C_B" "$title" "$C_RST"
  rule
  if (( ${#plan_args[@]} )); then
    bash "$BACKEND" "${plan_args[@]}"
  fi
  rule
  printf '%sApply these changes? [y/N] %s' "$C_B" "$C_RST"
  local ans=""
  stty echo 2>/dev/null
  IFS= read -r ans 2>/dev/null
  if [[ ${ans,,} != y && ${ans,,} != yes ]]; then
    printf '%sCancelled — nothing was changed.%s\n' "$C_MUT" "$C_RST"
    pause_key
    term_init
    return 1
  fi
  rule
  bash "$BACKEND" "${apply_args[@]}"
  local rc=$?
  rule
  if (( rc == 0 )); then
    printf '%sDone.%s\n' "$C_GRN" "$C_RST"
  else
    printf '%sFinished with errors (exit %d).%s\n' "$C_ERR" "$rc" "$C_RST"
  fi
  pause_key
  term_init
  return $rc
}

# ---------------------------------------------------------------- screens


check_label() {
  case "$1" in
    arch)      echo "Arch Linux" ;;
    root)      echo "Privileges" ;;
    network)   echo "Network" ;;
    multilib)  echo "multilib repository" ;;
    cpu)       echo "CPU" ;;
    ram)       echo "Memory" ;;
    gpu)       echo "Graphics" ;;
    gaming)    echo "Gaming packages" ;;
    proton)    echo "Proton-GE" ;;
    aur)       echo "AUR helper" ;;
    tweaks)    echo "Performance tweaks" ;;
    staleness) echo "Last full update" ;;
    mirrors)   echo "Mirror list" ;;
    cache)     echo "Package cache" ;;
    snapshots) echo "Snapshots" ;;
    flatpak)   echo "Flatpak" ;;
    update)    echo "Pending updates" ;;
    *)         echo "$1" ;;
  esac
}

screen_overview() {
  while :; do
    busy "Reading system status…"
    backend check
    clear_list
    local line k s d
    for line in "${RESULT[@]}"; do
      IFS='|' read -r k s d <<<"$line"
      [[ -z $k ]] && continue
      L_LABEL+=("$(check_label "$k")")
      L_STATE+=("$s")
      L_DESC+=("$d")
      L_TAG+=("$s")
    done
    (( ${#L_LABEL[@]} == 0 )) && L_LABEL=("no data") && L_STATE=("warn") && L_DESC=("The backend returned nothing.") && L_TAG=("")
    list_screen "System overview" "↑↓ move   enter re-check   esc back   q quit"
    case $? in
      0) : ;;      # enter falls through the loop and re-runs the checks
      1) return 0 ;;
      2) return 2 ;;
    esac
  done
}

screen_diagnose() {
  busy "Running functional tests…"
  backend diagnose
  clear_list
  local line _t key st title detail fix
  for line in "${RESULT[@]}"; do
    [[ $line == DIA\|* ]] || continue
    IFS='|' read -r _t key st title detail fix <<<"$line"
    L_LABEL+=("$title")
    L_STATE+=("$st")
    L_TAG+=("")
    if [[ -n $fix ]]; then
      L_DESC+=("$detail   ·   Fix: $fix")
    else
      L_DESC+=("$detail")
    fi
  done
  (( ${#L_LABEL[@]} == 0 )) && { msgbox "Diagnose" "No results — is the backend able to run here?"; return 0; }
  list_screen "Diagnose" "↑↓ move   esc back   q quit"
  [[ $? == 2 ]] && return 2
  return 0
}

screen_changelog() {
  backend log
  pager_screen "Change log" "${RESULT[@]}"
  [[ $? == 2 ]] && return 2
  return 0
}

screen_packages() {
  busy "Reading package list…"
  backend packages
  clear_list
  local line _t grp name inst
  local -a names=()
  for line in "${RESULT[@]}"; do
    [[ $line == PKG\|* ]] || continue
    IFS='|' read -r _t grp name inst <<<"$line"
    names+=("$name")
    L_LABEL+=("$name")
    L_TAG+=("$grp")
    L_STATE+=("")
    L_SEL+=("$inst")
    if [[ $inst == 1 ]]; then
      L_DESC+=("$name — already installed (group: $grp). Leaving it selected is harmless.")
    else
      L_DESC+=("$name — not installed (group: $grp). Select it to install.")
    fi
  done
  (( ${#L_LABEL[@]} == 0 )) && { msgbox "Packages" "No package data returned."; return 0; }

  list_screen "Choose packages   ·   space toggles" \
              "space toggle   enter install selected   esc back   q quit" 1
  local rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && return 0

  local -a want=()
  local i
  for i in "${!names[@]}"; do
    [[ ${L_SEL[i]} == 1 ]] && want+=("${names[i]}")
  done
  (( ${#want[@]} == 0 )) && { msgbox "Packages" "Nothing selected."; return 0; }

  term_done
  clear
  printf '%s%s%s\n' "$C_RED$C_B" "Install selected packages" "$C_RST"
  rule
  printf 'These %d packages will be installed (already-present ones are skipped):\n\n' "${#want[@]}"
  printf '  %s\n' "${want[@]}"
  rule
  printf '%sProceed? [y/N] %s' "$C_B" "$C_RST"
  local ans=""; stty echo 2>/dev/null; IFS= read -r ans 2>/dev/null
  if [[ ${ans,,} == y || ${ans,,} == yes ]]; then
    rule
    bash "$BACKEND" apply selected "${want[@]}"
    rule
    printf '%sDone.%s\n' "$C_GRN" "$C_RST"
  else
    printf '%sCancelled.%s\n' "$C_MUT" "$C_RST"
  fi
  pause_key
  term_init
  return 0
}

screen_apps() {
  busy "Reading installed applications…"
  backend apps
  clear_list
  local line _t src name ver size prot desc
  local -a names=() prots=()
  for line in "${RESULT[@]}"; do
    [[ $line == APP\|* ]] || continue
    IFS='|' read -r _t src name ver size prot desc <<<"$line"
    names+=("$name"); prots+=("$prot")
    L_LABEL+=("$name")
    L_TAG+=("$([[ $src == flatpak ]] && echo flatpak || echo "$size")")
    L_STATE+=("")
    L_SEL+=("0")
    if [[ $prot == 1 ]]; then
      L_DESC+=("$name $ver — PROTECTED. Critical to a working system; the backend will refuse to remove it. $desc")
    else
      L_DESC+=("$name $ver ($src, $size) — $desc")
    fi
  done
  (( ${#L_LABEL[@]} == 0 )) && { msgbox "Applications" "No application data returned."; return 0; }

  list_screen "Installed applications   ·   space marks for removal" \
              "space mark   enter uninstall marked   esc back   q quit" 1
  local rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && return 0

  local -a want=(); local i blocked=""
  for i in "${!names[@]}"; do
    if [[ ${L_SEL[i]} == 1 ]]; then
      if [[ ${prots[i]} == 1 ]]; then blocked+=" ${names[i]}"; else want+=("${names[i]}"); fi
    fi
  done
  if [[ -n $blocked ]]; then
    msgbox "Protected packages" "Refusing to remove:$blocked — these are critical system packages. Unmark them and try again."
    return 0
  fi
  (( ${#want[@]} == 0 )) && { msgbox "Applications" "Nothing marked."; return 0; }

  do_action "Uninstall applications" plan remove "${want[@]}" -- apply remove "${want[@]}"
  return 0
}

screen_kernels() {
  while :; do
    busy "Reading kernels…"
    backend kernels
    clear_list
    local line _t name src desc inst run
    local -a names=() insts=() runs=()
    for line in "${RESULT[@]}"; do
      [[ $line == KRN\|* ]] || continue
      IFS='|' read -r _t name src desc inst run <<<"$line"
      names+=("$name"); insts+=("$inst"); runs+=("$run")
      L_LABEL+=("$name")
      L_STATE+=("$([[ $inst == 1 ]] && echo on || echo off)")
      if [[ $run == 1 ]]; then
        L_TAG+=("running")
        L_DESC+=("$desc — installed, and this is the kernel you are booted into right now. It cannot be removed.")
      elif [[ $inst == 1 ]]; then
        L_TAG+=("installed")
        L_DESC+=("$desc — installed but not running. Enter to remove it.")
      else
        L_TAG+=("$src")
        L_DESC+=("$desc — not installed. Enter to install it alongside your current kernel; nothing is replaced.")
      fi
    done
    (( ${#L_LABEL[@]} == 0 )) && { msgbox "Kernels" "No kernel data returned."; return 0; }

    list_screen "Kernels" "enter install/remove   esc back   q quit"
    local rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && return 0

    local i=$L_INDEX n="${names[L_INDEX]}"
    if [[ ${runs[i]} == 1 ]]; then
      msgbox "Kernels" "$n is the running kernel — reboot into another one before removing it."
    elif [[ ${insts[i]} == 1 ]]; then
      do_action "Remove kernel: $n" plan remove-kernel "$n" -- apply remove-kernel "$n"
    else
      do_action "Install kernel: $n" plan kernel "$n" -- apply kernel "$n"
    fi
  done
}

screen_restore() {
  while :; do
    busy "Looking for backups…"
    backend restore-list
    clear_list
    local line _t id bak orig ts
    local -a ids=()
    for line in "${RESULT[@]}"; do
      [[ $line == RST\|* ]] || continue
      IFS='|' read -r _t id bak orig ts <<<"$line"
      ids+=("$id")
      L_LABEL+=("$id")
      L_STATE+=("")
      L_TAG+=("")
      if [[ $id == snapper ]]; then
        L_DESC+=("$ts")
      else
        L_DESC+=("Backup of $orig, taken $ts. Enter restores it over the current file (the current one is kept as .before-restore).")
      fi
    done
    if (( ${#L_LABEL[@]} == 0 )); then
      msgbox "Restore" "No backups found. Akari only creates them when it edits a file, so an untouched system has none."
      return 0
    fi

    list_screen "Restore backups" "enter restore   esc back   q quit"
    local rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && return 0

    local id="${ids[L_INDEX]}"
    if [[ $id == snapper ]]; then
      msgbox "Restore" "Snapper snapshots are managed with 'snapper list' and 'snapper rollback' — not from here."
    else
      do_action "Restore: $id" plan restore "$id" -- apply restore "$id"
    fi
  done
}

# Undo the backend's percent-encoding of pipe-bearing fields (game titles
# and launch strings). '%25' last, or a literal "%7C" in a title becomes a
# separator.
gam_dec() { local s=${1//%7C/|}; printf '%s' "${s//%25/%}"; }

# Toggle list that builds a launch-options string, shared by every launcher.
# Sets BUILT_OPTS. Returns 0 on confirm, 1 on cancel, 2 on quit.
BUILT_OPTS=""
build_opts_screen() {   # build_opts_screen <title> <existing-options> [hybrid]
  local title=$1 existing=${2:-} hybrid=${3:-0}
  BUILT_OPTS=""
  clear_list

  # label|token-to-match|description
  local -a rows=(
    "GameMode|gamemoderun|Ask gamemoded to apply the performance governor while the game runs."
    "MangoHud|mangohud|Overlay showing FPS, frametimes, CPU/GPU load."
    "Proton Wayland|PROTON_ENABLE_WAYLAND|Native Wayland instead of XWayland. Better on Hyprland, still experimental."
    "DLSS updater|PROTON_ENABLE_NGX_UPDATER|Let Proton keep the game's DLSS libraries current."
    "Gamescope (fullscreen)|gamescope|Run the game inside a gamescope micro-compositor."
  )
  # Only meaningful with a discrete NVIDIA card alongside an integrated one.
  (( hybrid )) && rows+=(
    "Render on the NVIDIA GPU|__NV_PRIME_RENDER_OFFLOAD|Hybrid graphics: send this game to the discrete card instead of the iGPU."
  )

  local r label token desc
  local -a tokens=()
  for r in "${rows[@]}"; do
    IFS='|' read -r label token desc <<<"$r"
    tokens+=("$token")
    L_LABEL+=("$label")
    L_DESC+=("$desc")
    L_STATE+=(""); L_TAG+=("")
    L_SEL+=("$([[ $existing == *"$token"* ]] && echo 1 || echo 0)")
  done

  list_screen "$title" "space toggle   enter apply   esc cancel   q quit" 1
  local rc=$?
  (( rc != 0 )) && return $rc

  # Order matters: environment first, then wrappers, and gamescope must sit
  # immediately before %command%.
  local env="" wrap="" i
  for i in "${!tokens[@]}"; do
    [[ ${L_SEL[i]} == 1 ]] || continue
    case ${tokens[i]} in
      __NV_PRIME_RENDER_OFFLOAD)
        env+="__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia "
        env+="__VK_LAYER_NV_optimus=NVIDIA_only " ;;
      PROTON_ENABLE_WAYLAND)     env+="PROTON_ENABLE_WAYLAND=1 " ;;
      PROTON_ENABLE_NGX_UPDATER) env+="PROTON_ENABLE_NGX_UPDATER=1 " ;;
      gamemoderun) wrap+="gamemoderun " ;;
      mangohud)    wrap+="mangohud " ;;
      gamescope)   wrap+="gamescope -f -- " ;;
    esac
  done
  BUILT_OPTS="${env}${wrap}"
  # An empty string is a valid thing to apply — it clears the options.
  [[ -n $BUILT_OPTS ]] && BUILT_OPTS+="%command%"
  return 0
}

# True when an NVIDIA card sits alongside an integrated one. Cached: this
# costs a full backend check, and it cannot change while the tool is open.
HYBRID_GPU=""
hybrid_gpu() {
  [[ -n $HYBRID_GPU ]] && return "$HYBRID_GPU"
  local n=0 i=0
  backend check
  local line k
  for line in "${RESULT[@]}"; do
    IFS='|' read -r k _ _ <<<"$line"
    [[ $k == gpu_nvidia ]] && n=1
    [[ $k == gpu_amd || $k == gpu_intel ]] && i=1
  done
  if (( n && i )); then HYBRID_GPU=0; else HYBRID_GPU=1; fi
  return "$HYBRID_GPU"
}

screen_games() {
  while :; do
    busy "Reading your game libraries…"
    backend games
    clear_list
    local line _t src gid name state size runner opts
    local -a srcs=() ids=() cur=() names=()
    local -a notice=()
    for line in "${RESULT[@]}"; do
      [[ $line == GAM\|* ]] || continue
      IFS='|' read -r _t src gid name state size runner opts <<<"$line"
      if [[ $state == unavailable ]]; then
        notice+=("$src: $(gam_dec "$opts")")
        continue
      fi
      name=$(gam_dec "$name"); opts=$(gam_dec "$opts")
      srcs+=("$src"); ids+=("$gid"); cur+=("$opts"); names+=("$name")
      L_LABEL+=("$name")
      L_TAG+=("$src")
      L_STATE+=("$([[ -n $opts ]] && echo on || echo off)")
      if [[ -n $opts ]]; then
        L_DESC+=("$size · runs on ${runner:--} · launch options: $opts   ·   Enter to edit them.")
      else
        L_DESC+=("$size · runs on ${runner:--} · no launch options set.   ·   Enter to add some.")
      fi
    done

    if (( ${#L_LABEL[@]} == 0 )); then
      local why="No games found."
      (( ${#notice[@]} )) && why+=" $(printf '%s ' "${notice[@]}")"
      why+=" Install Steam, Lutris or Heroic and launch it once so it writes its library, then come back."
      msgbox "Games" "$why"
      return 0
    fi

    list_screen "Games   ·   ${#L_LABEL[@]} installed" \
                "enter launch options   esc back   q quit"
    local rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && return 0

    local i=$L_INDEX
    local src=${srcs[i]} gid=${ids[i]} gname=${names[i]} existing=${cur[i]}

    # Two separate things can be changed per game: what wraps the command,
    # and which Proton/Wine actually runs it.
    clear_list
    L_LABEL=("Launch options" "Compatibility tool")
    L_DESC=(
      "Wrap the game with gamemoderun, MangoHud, gamescope and Proton environment variables. Current: ${existing:-none}."
      "Choose which installed Proton or Wine build this game runs on, overriding the launcher default. This is what a newly installed build needs before it has any effect."
    )
    L_STATE=("" ""); L_TAG=("" "")
    list_screen "$gname" "enter select   esc back   q quit"
    rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && continue

    if (( L_INDEX == 0 )); then
      local hy=0; hybrid_gpu && hy=1
      build_opts_screen "Launch options: $gname" "$existing" "$hy"
      rc=$?
      (( rc == 2 )) && return 2
      (( rc == 1 )) && continue
      do_action "Launch options: $gname" \
                plan gameopts "$src" "$gid" "$BUILT_OPTS" \
                -- apply gameopts "$src" "$gid" "$BUILT_OPTS"
    else
      screen_gamerunner "$src" "$gid" "$gname"
      rc=$?
      (( rc == 2 )) && return 2
    fi
  done
}

# Pick which installed build a single game runs on.
screen_gamerunner() {   # screen_gamerunner <source> <id> <name>
  local src=$1 gid=$2 gname=$3
  busy "Reading installed builds…"
  # The backend already knows which builds exist for which launcher; asking
  # it beats re-deriving the directory layout here.
  backend proton
  clear_list
  local line _t kind track name target size detail
  local -a builds=()
  for line in "${RESULT[@]}"; do
    [[ $line == PRT\|* ]] || continue
    IFS='|' read -r _t kind track name target size detail <<<"$line"
    [[ $kind == installed ]] || continue
    case "$src" in
      steam)  [[ $target == steam ]]  || continue ;;
      lutris) [[ $target == lutris ]] || continue ;;
      heroic) [[ $target == heroic-* ]] || continue ;;
      *) continue ;;
    esac
    [[ " ${builds[*]} " == *" $name "* ]] && continue
    builds+=("$name")
    L_LABEL+=("$name")
    L_STATE+=("off"); L_TAG+=("$target")
    L_DESC+=("Run $gname on $name. Existing prefixes are kept; a large version jump can still make a game want a fresh one.")
  done

  if (( ${#builds[@]} == 0 )); then
    msgbox "Compatibility tool" "No builds are installed for $src yet. Install one from the Proton & Wine builds screen first."
    return 0
  fi

  list_screen "Compatibility tool: $gname" "enter use it   esc back   q quit"
  local rc=$?
  (( rc == 2 )) && return 2
  (( rc == 1 )) && return 0

  local b=${builds[L_INDEX]}
  do_action "Run $gname on $b" \
            plan gamerunner "$src" "$gid" "$b" \
            -- apply gamerunner "$src" "$gid" "$b"
  return 0
}

# Set by default_for(); avoids a subshell so the caller can read it too.
_dflt=""
# Sets the global _dflt. Deliberately not echoed: reading it through a
# command substitution would run in a subshell and lose the assignment,
# and the caller needs the value in two places.
default_for() {   # default_for <target>   (reads dtarget/dbuild from caller)
  local i
  _dflt=""
  for i in "${!dtarget[@]}"; do
    if [[ ${dtarget[i]} == "$1" ]]; then _dflt=${dbuild[i]}; break; fi
  done
}

screen_proton() {
  while :; do
    busy "Checking Proton builds (this may hit the network)…"
    backend proton
    clear_list
    local line _t kind track name target size detail
    local -a kinds=() tracks=() names=() targets=()
    local -a errs=()
    # target -> build it currently uses. Kept as two parallel lists because
    # bash 4 associative arrays are avoidable here and this stays portable.
    local -a dtarget=() dbuild=()

    # A leading action row: pruning is the thing people need and never find,
    # because each build is well over a gigabyte.
    kinds+=("prune"); tracks+=("-"); names+=("-"); targets+=("-")
    L_LABEL+=("Prune old builds")
    L_TAG+=("cleanup")
    L_STATE+=("")
    L_DESC+=("Keep only the two newest builds per launcher and delete the rest. Each GE build is roughly 1.5 GB, so this is usually the largest thing Akari can free.")

    # Two passes: the default lines have to be known before the installed
    # ones are rendered, and the backend emits them interleaved.
    for line in "${RESULT[@]}"; do
      [[ $line == PRT\|* ]] || continue
      IFS='|' read -r _t kind track name target size detail <<<"$line"
      [[ $kind == default ]] && { dtarget+=("$target"); dbuild+=("$name"); }
    done

    for line in "${RESULT[@]}"; do
      [[ $line == PRT\|* ]] || continue
      IFS='|' read -r _t kind track name target size detail <<<"$line"
      case $kind in
        default)
          # detail carries ok|missing|none
          [[ $detail == missing ]] && errs+=("$target is set to use $name, but that build is not installed any more — it will fall back to its own Proton/Wine until you pick another")
          continue ;;
        error)
          errs+=("$track: $detail") ;;
        installed)
          kinds+=("installed"); tracks+=("$track"); names+=("$name"); targets+=("$target")
          L_LABEL+=("$name")
          default_for "$target"
          if [[ $_dflt == "$name" ]]; then
            L_TAG+=("$target · in use")
            L_STATE+=("on")
            L_DESC+=("Installed for $target ($size) and currently in use by default. Enter to remove it or switch away.")
          else
            L_TAG+=("$target")
            L_STATE+=("on")
            L_DESC+=("Installed for $target ($size) at $detail, but NOT in use — $target still runs games on ${_dflt:-its stock Proton/Wine}. Enter to start using it, or to remove it.")
          fi ;;
        remote)
          kinds+=("remote"); tracks+=("$track"); names+=("$name"); targets+=("$target")
          L_LABEL+=("$name")
          L_TAG+=("$target")
          L_STATE+=("off")
          L_DESC+=("Available for $target ($track). Enter to download it, verify its sha512sum, unpack it as your user and start using it. Installing alone never switches anything — that is why a new build can look like it did nothing.") ;;
      esac
    done

    if (( ${#errs[@]} )); then
      msgbox "Proton" "$(printf '%s. ' "${errs[@]}")If a network error is listed, GitHub allows 60 requests an hour without a login — wait a few minutes and try again. Anything already installed is still listed."
    fi

    list_screen "Proton & Wine builds" "enter use/install/remove   esc back   q quit"
    local rc=$?
    (( rc == 2 )) && return 2
    (( rc == 1 )) && return 0

    local i=$L_INDEX
    case ${kinds[i]} in
      prune)
        do_action "Prune old builds" plan proton-prune 2 -- apply proton-prune 2 ;;
      installed)
        # Two very different things to do with an installed build, so ask.
        clear_list
        L_LABEL=("Use it by default" "Remove it")
        L_DESC=(
          "Point ${targets[i]} at ${names[i]} for every game without its own override. This is the step that actually makes a newly installed build take effect."
          "Delete ${names[i]} from disk. Games still set to use it fall back to the launcher's own Proton/Wine."
        )
        L_STATE=("" ""); L_TAG=("" "")
        list_screen "${names[i]}" "enter select   esc back   q quit"
        local arc=$?
        (( arc == 2 )) && return 2
        (( arc == 1 )) && continue
        if (( L_INDEX == 0 )); then
          do_action "Use ${names[i]} by default" \
                    plan compat-default "${targets[i]}" "${names[i]}" \
                    -- apply compat-default "${targets[i]}" "${names[i]}"
        else
          do_action "Remove ${names[i]}" \
                    plan proton-remove "${names[i]}" "${targets[i]}" \
                    -- apply proton-remove "${names[i]}" "${targets[i]}"
        fi ;;
      remote)
        # Install and select in one step: installing alone is exactly the
        # thing that leaves people wondering why nothing changed.
        do_action "Install and use ${names[i]}" \
                  plan proton-install "${tracks[i]}" "${names[i]}" "${targets[i]}" \
                  -- apply proton-install "${tracks[i]}" "${names[i]}" "${targets[i]}" default ;;
    esac
  done
}

